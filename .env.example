# ============================================================
#  Variables de entorno - Sistema de Gestión de Gimnasio
#  Copia este archivo como .env y rellena los valores reales.
#  NUNCA subas el archivo .env a git (está en .gitignore).
# ============================================================

# Cadena de conexión a PostgreSQL.
# Local:  postgresql://usuario:password@localhost:5432/gym
# Neon:   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/gym?sslmode=require
DATABASE_URL=postgresql://gym_app:cambia_esta_clave@localhost:5432/gym

# Secreto para firmar los JWT. Debe ser largo y aleatorio.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=pon_aqui_un_secreto_muy_largo_y_aleatorio

# Puerto para desarrollo local
PORT=3000

# Entorno: development | production
NODE_ENV=development
